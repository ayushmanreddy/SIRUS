# Use development for normal local development or offline-demo to enforce local-only AI endpoints.
APP_PROFILE=development
APP_NAME=Sovereign AI Workbench
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////app/data/workbench.db

# These must be loopback or private-network addresses when APP_PROFILE=offline-demo.
LLM_SERVICE_URL=http://host.docker.internal:8081
EMBEDDING_SERVICE_URL=http://host.docker.internal:8082
VECTOR_STORE_URL=http://qdrant:6333
MODEL_ARTIFACT_ROOT=/app/models
