# ---------------------------------------------------------------------------
# SIRUS environment example. Copy to .env and edit for your machine.
# The defaults below target docker compose (service names, container paths).
# For native execution use: LLM_SERVICE_URL=http://localhost:11434,
# EMBEDDING_SERVICE_URL=http://localhost:11434,
# VECTOR_STORE_URL=http://localhost:6333,
# DATABASE_URL=sqlite:///./data/workbench.db
# ---------------------------------------------------------------------------
APP_PROFILE=development
APP_NAME=SIRUS
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////app/data/workbench.db

# Local Ollama-compatible service. In Compose, "ollama" is the service name.
LLM_SERVICE_URL=http://ollama:11434
EMBEDDING_SERVICE_URL=http://ollama:11434
VECTOR_STORE_URL=http://qdrant:6333

# Models must be pulled into Ollama before readiness turns green.
LLM_MODEL=llama3.1:8b
REASONING_MODEL=llama3.1:8b
CODING_MODEL=qwen2.5-coder:7b
VISION_MODEL=llava:7b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.1

# Vector storage and retrieval
QDRANT_COLLECTION=documents
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.25

# Chunking (characters, not tokens)
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Upload and extraction limits
ALLOWED_FILE_TYPES=pdf,txt,docx
MAX_UPLOAD_MB=10
MAX_PAGE_COUNT=100
MAX_EXTRACTED_CHARS=5000000
MAX_CHUNKS_PER_DOCUMENT=2000

# Embedding batching
EMBEDDING_BATCH_SIZE=16

# OCR fallback for image-only PDF pages. EasyOCR downloads weights on first use.
OCR_ENABLED=true
OCR_LANGUAGES=en
OCR_DPI=200
PDF_NATIVE_TEXT_MIN_CHARS=40

# HTTP timeouts (seconds)
REQUEST_TIMEOUT_SECONDS=3
# Qdrant can take longer than the probe timeout when creating a collection.
VECTOR_STORE_TIMEOUT_SECONDS=30
GENERATION_TIMEOUT_SECONDS=120

# Optional local model artifact verification (legacy feature)
MODEL_ARTIFACT_ROOT=/app/models
MODEL_MANIFEST_PATH=/app/models/manifest.json
